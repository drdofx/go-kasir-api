APP_ENV=development
PORT=8080
DB_CONN=postgresql://postgres.[PROJECT_ID]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-this-admin-password
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
AUTO_MIGRATE=true
MIGRATIONS_PATH=migrations
SERVER_READ_TIMEOUT=10s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s
MAX_REQUEST_BODY_BYTES=1048576
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
